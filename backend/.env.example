# ── Hyperliquid copy-trading backend config ──────────────────────────────
# Copy this file to  backend/.env  and fill in your values.

# The signing key used to place orders.
# STRONGLY recommended: create a Hyperliquid "API wallet" (on the website:
# top-right menu -> "API") which can TRADE but CANNOT WITHDRAW. Use that key here.
# Never paste your seed phrase -- only the 0x... private key. Never commit this file.
HL_SECRET_KEY=0xyour_api_wallet_private_key_here

# Your MAIN account address (the one holding the funds).
# If HL_SECRET_KEY above is an API/agent wallet, set this to your main 0x address.
# If HL_SECRET_KEY is your main wallet's own key, you can leave this blank.
HL_ACCOUNT_ADDRESS=

# Network: mainnet or testnet
HL_NETWORK=mainnet

# ── Safety guardrails ────────────────────────────────────────────────────
# The app boots in SAFE mode; flip ARM in the UI to place real orders.
# Hard cap (USD notional) on any single order the backend will accept.
MAX_ORDER_NOTIONAL_USD=2000

# Default slippage tolerance for market orders (0.01 = 1%).
DEFAULT_SLIPPAGE=0.01

# Comma-separated origins allowed to call the API (your Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
